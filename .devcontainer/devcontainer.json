{
    "name": "VSCode Dev Container Template",
    // "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
    "dockerFile": "Dockerfile",
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-python.vscode-pylance",
          "bierner.markdown-mermaid",
          "ms-toolsai.jupyter",
          "tomoki1207.pdf",
          "monokai.theme-monokai-pro-vscode",
          "esbenp.prettier-vscode",
          "mechatroner.rainbow-csv",
          "eamodio.gitlens",
          "ms-azuretools.vscode-docker",
          "saoudrizwan.claude-dev",
          "openai.chatgpt"
        ],
        "settings": {
          "python.defaultInterpreterPath": "/workspaces/vscode/.venv/bin/python"
        }
      }
    },
    "postCreateCommand": "sudo chown -R vscode:vscode /workspaces/vscode && uv python list",
    // "postStartCommand": "ollama serve &",
    "remoteUser": "vscode"
  }
  