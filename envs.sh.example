#!/bin/bash

# GitHub Integration (required for dynamic portfolio data)
export GITHUB_USERNAME="your-github-username"
export GITHUB_TOKEN="your-github-personal-access-token"

# Contact Information
export CONTACT_EMAIL="your-email@example.com"

# Social Media Links
export LINKEDIN_URL="https://linkedin.com/in/your-profile"

# Resume (Google link)
export RESUME_URL="https://docs.google.com/document/d/YOUR_FILE_ID/export?format=pdf"

# Optional: Override static directory (default: data/static)
# export STATIC_DIR="/workspaces/project/data/static"

# Application Settings
export DEBUG="true"
export SITE_TITLE="Personal Portfolio"  # Will be overridden by GitHub profile data
export SITE_DESCRIPTION="AI/ML Engineer & Data Scientist"  # Will be overridden by GitHub bio
export SESSION_SECRET="replace-with-a-long-random-string"

# Optional: SMTP settings for contact form
export SMTP_HOST="smtp.yourprovider.com"
export SMTP_PORT="587"
export SMTP_USER="your_username"
export SMTP_PASSWORD="your_password"
export SMTP_FROM="you@example.com"     # defaults to CONTACT_EMAIL
export SMTP_TO="you@example.com"       # defaults to CONTACT_EMAIL
export SMTP_TLS="true"                 # true/false
export RATE_IP_PER_HOUR=3
export RATE_GLOBAL_PER_DAY=50

# Optional: CAPTCHA hash secret. If omitted, the app uses SESSION_SECRET/session key.
# export CAPTCHA_SECRET="replace-with-a-long-random-string"

# Optional: free-first chat generation. If omitted or rate-limited, chat falls back
# to local retrieval over committed portfolio data.
# export HUGGINGFACE_API_KEY="hf_your_token"
# export HUGGINGFACE_CHAT_MODEL="HuggingFaceTB/SmolLM2-1.7B-Instruct"
export RAG_MAX_RESPONSE_TOKENS=220
export RAG_TEMPERATURE=0.3
