#!/usr/bin/env bash
#
# Regenerates api/requirements.txt from pyproject.toml + uv.lock.
# This file is consumed by Vercel for the Python serverless function.
#
# Usage:
#   ./scripts/sync-vercel-reqs
#
set -euo pipefail

echo "→ Regenerating api/requirements.txt from uv.lock..."

# Export to temp file first (uv always adds its own header)
tmpfile=$(mktemp)
uv export \
  --format requirements-txt \
  --no-dev \
  --no-hashes \
  --output-file "$tmpfile"

# Write clean header + the actual requirements
cat > api/requirements.txt << 'HEADER'
# =============================================================================
# AUTO-GENERATED — Run this after changing dependencies in pyproject.toml:
#
#   ./scripts/sync-vercel-reqs
#
# This file is used by Vercel for the api/ serverless function.
# =============================================================================

HEADER

# Append everything after uv's autogenerated comment line
tail -n +3 "$tmpfile" >> api/requirements.txt
rm -f "$tmpfile"

echo "✓ api/requirements.txt updated successfully."
echo ""
echo "Next steps:"
echo "  git add api/requirements.txt"
echo "  git commit"
